{
  "base_contract": "0.2.0",
  "status": "draft-not-active",
  "wire_change": "新增字段及内容目标ID/版本语义，须新契约版本与两端迁移后启用，不修改0.2.0",
  "target_id": "content_registry.id，非案件id，非entity_id；仅服务端通过持久关联映射",
  "target_version": "内容处置资源的独立乐观版本；当前DDL缺失，不用content_version或wish.version代填",
  "case_version": "审核任务独立乐观版本；当前DDL缺失，待追加迁移和命令接线",
  "schemas": {
    "AuthorizedContentTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "wish",
            "application",
            "message",
            "story"
          ]
        },
        "id": {
          "type": "string",
          "description": "不透明资源标识；客户端不解析或由此推断身份",
          "example": "6c500000-0000-4000-8000-000000000001"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "allowed_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "postAdminContentsKindIdOffline",
              "postAdminContentsKindIdReleaseRestriction"
            ]
          }
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "allowed_actions"
      ]
    },
    "AuthorizedModerationCase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "不透明资源标识；客户端不解析或由此推断身份",
          "example": "6c500000-0000-4000-8000-000000000001"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "目标当前乐观版本；不是content_version、wish_expected_version或write_epoch"
        },
        "content_version": {
          "type": "integer",
          "minimum": 1
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "非全空白Unicode文本；此处不新增产品字数限制，传输安全上限按部署参数"
        },
        "school_related": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "machine_passed",
            "human_required",
            "approved",
            "rejected",
            "obsolete",
            "cancelled"
          ]
        },
        "target": {
          "$ref": "#/components/schemas/AuthorizedContentTarget"
        },
        "allowed_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "const": "postAdminModerationTasksIdDecision"
          }
        }
      },
      "required": [
        "id",
        "version",
        "content_version",
        "body",
        "status",
        "target",
        "allowed_actions"
      ],
      "additionalProperties": false
    }
  },
  "mapping": {
    "wish": "content_registry.entity_id -> wishes.id；再核对current_content_version",
    "application": "entity_id -> applications.id；再核对content_version、关联wish版本和当前资格",
    "message": "entity_id -> messages.id；再核对content_version、原会话/write_epoch和取消状态",
    "story": "entity_id -> story_versions.wish_id，与content_version对应story_version；不得假造独立story_versions.id"
  },
  "case_states": {
    "pending": [],
    "machine_passed": [],
    "human_required": [
      "postAdminModerationTasksIdDecision"
    ],
    "approved": [],
    "rejected": [],
    "obsolete": [],
    "cancelled": []
  },
  "examples": [
    {
      "name": "human_review",
      "schema": "AuthorizedModerationCase",
      "value": {
        "id": "6c500000-0000-4000-8000-000000000001",
        "version": 7,
        "content_version": 3,
        "body": "合成案件文本",
        "status": "human_required",
        "target": {
          "kind": "wish",
          "id": "6c500000-0000-4000-8000-000000000002",
          "version": 11,
          "allowed_actions": []
        },
        "allowed_actions": [
          "postAdminModerationTasksIdDecision"
        ]
      }
    },
    {
      "name": "obsolete_no_actions",
      "schema": "AuthorizedModerationCase",
      "value": {
        "id": "6c500000-0000-4000-8000-000000000001",
        "version": 8,
        "content_version": 3,
        "body": "合成案件文本",
        "status": "obsolete",
        "target": {
          "kind": "wish",
          "id": "6c500000-0000-4000-8000-000000000002",
          "version": 12,
          "allowed_actions": []
        },
        "allowed_actions": []
      }
    }
  ]
}

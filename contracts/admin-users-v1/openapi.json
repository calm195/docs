  "components": {
    "securitySchemes": {
      "AdminBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "UserSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification": {
            "type": "string",
            "enum": [
              "unverified",
              "pending",
              "verified",
              "rejected"
            ]
          },
          "restriction": {
            "type": "string",
            "enum": [
              "normal",
              "muted",
              "banned"
            ]
          },
          "muted_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "display_name",
          "verification",
          "restriction",
          "muted_until",
          "created_at",
          "as_of"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "restriction": {
                  "const": "muted"
                }
              }
            },
            "then": {
              "properties": {
                "muted_until": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "else": {
              "properties": {
                "muted_until": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "ActivePenalty": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"

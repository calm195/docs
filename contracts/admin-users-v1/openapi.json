    "/admin/users": {
      "get": {
        "operationId": "adminUsersList",
        "summary": "现存小程序用户查询，含昵称包含搜索",
        "description": "规范语义见同包semantics.md。所有响应字段白名单，不含身份/匿名关联/案件正文。",
        "tags": [
          "admin-users"
        ],
        "x-req-ids": [
          "REQ-022",
          "REQ-018",
          "REQ-019"
        ],
        "x-implementation-status": "not-implemented",
        "x-success-schema": "UserPageEnvelope",
        "security": [
          {
            "AdminBearer": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "description": "当前普通账号UUID，精确查找；与其他条件AND",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "nickname",
            "in": "query",
            "required": false,
            "description": "首尾按semantics.md规定去空白，非空最多50码点；普通昵称字面包含，仅ASCII大小写不敏感；空词无筛选。此参数值必须从访问日志中屏蔽",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "verification",
            "in": "query",
            "required": false,
            "description": "省略表示全部；不接受all或空字符串",
            "schema": {
              "type": "string",
              "enum": [
                "unverified",
                "pending",
                "verified",
                "rejected"
              ]
            }
          },
          {
            "name": "restriction",
            "in": "query",
            "required": false,
            "description": "省略表示全部；按同一as_of计算，有效ban优先于mute",
            "schema": {
              "type": "string",
              "enum": [
                "normal",
                "muted",
                "banned"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "页大小；省略20，空值非法",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "服务端不透明游标；首请求省略，30分钟过期；后续完整回传原筛选",
            "schema": {
              "type": "string",
              "minLength": 1
            }

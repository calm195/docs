  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "State": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "account_version": {
            "type": "integer",
            "minimum": 1
          },
          "banned": {
            "type": "boolean"
          },
          "muted": {
            "type": "boolean"
          },
          "muted_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          },
          "allowed_actions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "ban",
                "unban",
                "mute",
                "unmute"
              ]
            }
          }
        },
        "required": [
          "user_id",
          "account_version",
          "banned",
          "muted",
          "muted_until",
          "as_of",
          "allowed_actions"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "muted": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "muted_until": {
                  "type": "string"
                }
              }
            },
            "else": {
              "properties": {
                "muted_until": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "Input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "去首尾空白后非空，UTF-8不超过2000字节"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "reason",
          "expected_version"
        ]
      },
      "Envelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": 0
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "$ref": "#/components/schemas/State"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "data"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "integer",
            "minimum": 1
          },
          "message": {
            "type": "string"
          },
          "error_code": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message",
          "error_code",
          "request_id"
        ]
      }
    }
  }
